@@ -0,0 +1,61 @@
+import axios, { AxiosError } from 'axios';
+import type { LocalFilesSession } from './filesystem';
+import { completeLocalFiles, LocalFilesTransportError } from './filesystem-service';
+import { localFilesConfigSchema } from './filesystem';
+
+const adapter = axios.defaults.adapter;
+const session: LocalFilesSession = {
+  id: 'session',
+  token: 'private-session-token',
+  version: 2,
+  root: { id: 'root', name: 'workspace', access: 'read' },
+  config: localFilesConfigSchema.parse({}),
+};
+afterEach(() => {
+  axios.defaults.adapter = adapter;
+});
+it('discards transport diagnostics, request credentials and file text before React Query sees a failure', async () => {
+  axios.defaults.adapter = async (config) => {
+    throw new AxiosError(
+      'password=diagnostic-secret',
+      'ERR_BAD_RESPONSE',
+      config,
+      {},
+      {
+        status: 503,
+        statusText: 'unavailable',
+        config,
+        headers: {},
+        data: { code: 'UNAVAILABLE', detail: 'private-response-secret' },
+      },
+    );
+  };
+  const error = await completeLocalFiles(session, 'request', {
+    ok: true,
+    value: { path: 'note.txt', content: 'private-file-text' },
+  }).catch((error: Error) => error);
+  expect(error).toBeInstanceOf(LocalFilesTransportError);
+  expect(error).toMatchObject({ code: 'UNAVAILABLE', message: 'UNAVAILABLE' });
+  expect(JSON.stringify(error)).not.toMatch(/private|password|config|response|headers/);
+  expect(Object.getOwnPropertyNames(error)).not.toContain('cause');
+});
+it('maps unapproved upstream messages to a safe stable code', async () => {
+  axios.defaults.adapter = async (config) => {
+    throw new AxiosError('arbitrary secret', undefined, config);
+  };
+  await expect(
+    completeLocalFiles(session, 'request', { ok: false, error: { code: 'CANCELLED' } }),
+  ).rejects.toMatchObject({ code: 'UNAVAILABLE', message: 'UNAVAILABLE' });
+});
+it('sends binary results as raw bytes, retaining the session credential only in its header', async () => {
+  axios.defaults.adapter = async (config) => {
+    expect(config.headers['Content-Type']).toBe('application/octet-stream');
+    expect(config.headers['X-Local-Files-Token']).toBe(session.token);
+    expect(Buffer.from(config.data)).toEqual(Buffer.from([0, 1, 128, 255]));
+    return { data: undefined, status: 204, statusText: 'No Content', headers: {}, config };
+  };
+  await completeLocalFiles(session, 'request', {
+    ok: true,
+    value: { path: 'report.pdf', binary: { mime: 'application/pdf', data: 'AAGA/w==' } },
+  });
+});
diff --git a/packages/data-provider/src/filesystem-service.ts b/packages/data-provider/src/filesystem-service.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c41b7c0d60ef6696eef48d418e14f39a21fb2ca6
--- /dev/null
+++ b/packages/data-provider/src/filesystem-service.ts
@@ -0,0 +1,72 @@
+import { z } from 'zod';
+import axios, { isAxiosError } from 'axios';
+import type { AxiosResponse } from 'axios';
+import type { LocalFilesRoot, LocalFilesSession, LocalFilesResult } from './filesystem';
+import { LOCAL_FILES_HEADER, LOCAL_FILES_VERSION, LOCAL_FILES_ERRORS } from './filesystem';
+import { apiBaseUrl } from './api-endpoints';
+
+const url = (id?: string): string =>
+  `${apiBaseUrl()}/api/local-files/sessions${id ? `/${encodeURIComponent(id)}` : ''}`;
+const options = (token: string) => ({ headers: { [LOCAL_FILES_HEADER]: token } });
+export class LocalFilesTransportError extends Error {
+  constructor(public readonly code: (typeof LOCAL_FILES_ERRORS)[number]) {
+    super(code);
+  }
+}
+const errorSchema = z.object({ code: z.enum(LOCAL_FILES_ERRORS) });
+/** React Query and console capture must never retain an Axios request containing file text or credentials. */
+async function send<T>(invoke: () => Promise<AxiosResponse<T>>): Promise<T> {
+  try {
+    return (await invoke()).data;
+  } catch (error) {
+    const parsed = errorSchema.safeParse(isAxiosError(error) ? error.response?.data : undefined);
+    throw new LocalFilesTransportError(parsed.success ? parsed.data.code : 'UNAVAILABLE');
+  }
+}
+export async function createLocalFilesSession(
+  conversationId: string,
+  root: LocalFilesRoot,
+): Promise<LocalFilesSession> {
+  return send(() =>
+    axios.post<LocalFilesSession>(url(), {
+      version: LOCAL_FILES_VERSION,
+      conversationId,
+      root,
+    }),
+  );
+}
+export async function heartbeatLocalFiles(session: LocalFilesSession): Promise<void> {
+  await send(() => axios.post(`${url(session.id)}/heartbeat`, {}, options(session.token)));
+}
+export async function completeLocalFiles(
+  session: LocalFilesSession,
+  id: string,
+  result: LocalFilesResult,
+): Promise<void> {
+  const binary = result.ok ? result.value.binary : undefined;
+  if (binary) {
+    await send(() =>
+      axios.post(
+        `${url(session.id)}/results/${encodeURIComponent(id)}`,
+        Uint8Array.from(atob(binary.data), (character) => character.charCodeAt(0)),
+        {
+          headers: {
+            ...options(session.token).headers,
+            'Content-Type': 'application/octet-stream',
+          },
+        },
+      ),
+    );
+    return;
+  }
+  await send(() =>
+    axios.post(
+      `${url(session.id)}/results/${encodeURIComponent(id)}`,
+      result,
+      options(session.token),
+    ),
+  );
+}
+export async function disconnectLocalFiles(session: LocalFilesSession): Promise<void> {
+  await send(() => axios.delete(url(session.id), options(session.token)));
+}
