diff --git a/packages/api/src/filesystem/reader.spec.ts b/packages/api/src/filesystem/reader.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8daae68c108f6639aa76d2a9928add66bf3db91f
