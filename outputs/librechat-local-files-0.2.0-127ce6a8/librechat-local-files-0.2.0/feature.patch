diff --git a/client/src/components/Filesystem/Panel.tsx b/client/src/components/Filesystem/Panel.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c1adc74ac91704a71d91c89b09261ded40f15917
--- /dev/null
+++ b/client/src/components/Filesystem/Panel.tsx
@@ -0,0 +1,240 @@
+import { useState } from 'react';
+import { Button } from '@librechat/client';
+import { useParams } from 'react-router-dom';
+import { QueryKeys } from 'librechat-data-provider';
+import { boundApprovalLabel } from '@librechat/chat';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import type { Folder } from './engine';
+import { useConnections, setConnection, disconnect, localFilesOwner } from './connection';
+import { Filesystem, FilesystemError, filesystemError } from './engine';
+import { registerFolder, recallFolder, localJournal } from './storage';
+import { useChatTransport } from '~/Providers/ChatTransportContext';
+import { useGetStartupConfig } from '~/data-provider/Endpoints';
+import { useAuthContext } from '~/hooks/AuthContext';
+import useLocalize from '~/hooks/useLocalize';
+import { errorKeys } from './copy';
+import Loading from './Loading';
+import Tree from './Tree';
+
+type Picker = Window & { showDirectoryPicker?: (options: { mode: 'read' }) => Promise<Folder> };
+export default function Panel() {
+  const localize = useLocalize();
+  const { user } = useAuthContext();
+  const owner = localFilesOwner(user) ?? '';
+  const transport = useChatTransport();
+  const { conversationId = 'new' } = useParams();
+  const entries = useConnections();
+  const candidate = entries.get(conversationId);
+  const entry = candidate?.owner === owner ? candidate : undefined;
+  const { data: startup } = useGetStartupConfig();
+  const config = startup?.localFiles;
+  const client = useQueryClient();
+  const [selected, setSelected] = useState('');
+  const [failure, setFailure] = useState<ReturnType<typeof filesystemError>>();
+  const supported =
+    window.isSecureContext &&
+    typeof (window as Picker).showDirectoryPicker === 'function' &&
+    !!navigator.locks;
+  const remembered = useQuery({
+    queryKey: [QueryKeys.localFiles, owner, 'remembered'],
+    queryFn: () => recallFolder(owner),
+    enabled: !!owner && supported && config?.available === true,
+    retry: false,
+  });
+  const connect = useMutation({
+    mutationFn: async ({ folder }: { folder: Folder }) => {
+      if (!config?.available || !owner) throw new FilesystemError('UNAVAILABLE');
+      let descriptor;
+      try {
+        descriptor = await registerFolder(owner, folder);
+      } catch (error) {
+        throw new FilesystemError(filesystemError(error));
+      }
+      if (entry) disconnect(entry);
+      setConnection(conversationId, {
+        owner,
+        conversationId,
+        root: descriptor,
+        engine: new Filesystem(folder, config, localJournal(owner)),
+        client,
+        stop: (id, generationCreatedAt) =>
+          transport.abort({ conversationId: id, generationCreatedAt }),
+      });
+      setSelected('');
+      setFailure(undefined);
+      await client.invalidateQueries({ queryKey: [QueryKeys.localFiles, owner, 'remembered'] });
+    },
+    onError: (error) => setFailure(filesystemError(error)),
+  });
+  const preview = useQuery({
+    queryKey: [QueryKeys.localFiles, owner, entry?.root.id, 'preview', selected],
+    enabled: !!entry && !!selected,
+    queryFn: async () => {
+      const result = await entry!.engine.inspect({ operation: 'read', path: selected });
+      if (!result.ok) throw new FilesystemError(result.error.code);
+      return result.value;
+    },
+    retry: false,
+    refetchOnWindowFocus: false,
+    cacheTime: 0,
+  });
+  const choose = async () => {
+    try {
+      const folder = await (window as Picker).showDirectoryPicker!({ mode: 'read' });
+      connect.mutate({ folder });
+    } catch (error) {
+      setFailure(filesystemError(error));
+    }
+  };
+  const restore = async () => {
+    const saved = remembered.data;
+    if (!saved) return;
+    try {
+      if ((await saved.folder.requestPermission({ mode: 'read' })) !== 'granted')
+        throw new FilesystemError('PERMISSION_DENIED');
+      connect.mutate(saved);
+    } catch (error) {
+      setFailure(filesystemError(error));
+    }
+  };
+  const enable = async () => {
+    if (!entry || !config) return;
+    const engine = new Filesystem(entry.engine.folder, config, localJournal(owner));
+    try {
+      if (!(await engine.enable())) throw new FilesystemError('PERMISSION_DENIED');
+      disconnect(entry);
+      setConnection(conversationId, {
+        owner,
+        conversationId,
+        engine,
+        root: { ...entry.root, access: 'readwrite' },
+        client,
+        stop: (id, generationCreatedAt) =>
+          transport.abort({ conversationId: id, generationCreatedAt }),
+      });
+      setFailure(undefined);
+    } catch (error) {
+      setFailure(filesystemError(error));
+    }
+  };
+  return (
+    <section className="flex min-h-0 flex-col gap-3 p-3" aria-label={localize('com_fs_title')}>
+      <h2 className="text-lg font-semibold">{localize('com_fs_title')}</h2>
+      <p className="text-text-secondary text-sm">{localize('com_fs_description')}</p>
+      {!supported && <p role="status">{localize('com_fs_browser')}</p>}
+      {supported && !config?.available && (
+        <p role="status">{localize('com_fs_approval_disabled')}</p>
+      )}
+      {supported && config?.available && (
+        <>
+          <div className="flex flex-wrap gap-2">
+            <Button
+              variant="outline"
+              disabled={connect.isLoading}
+              onClick={() => {
+                void choose();
+              }}
+            >
+              {localize('com_fs_choose')}
+            </Button>
+            {!entry && remembered.data && (
+              <Button
+                variant="quiet"
+                disabled={connect.isLoading}
+                onClick={() => {
+                  void restore();
+                }}
+              >
+                {localize('com_fs_reconnect')}
+              </Button>
+            )}
+          </div>
+          {entry && (
+            <>
+              <div role="status" className="flex flex-wrap items-center gap-2">
+                <bdi>{boundApprovalLabel(entry.root.name, 255).label}</bdi>
+                <span className="text-text-secondary text-sm">
+                  {localize(
+                    entry.root.access === 'read' ? 'com_fs_read_only' : 'com_fs_review_changes',
+                  )}
+                </span>
+              </div>
+              <div className="flex flex-wrap gap-2">
+                {entry.root.access === 'read' && (
+                  <Button
+                    variant="outline"
+                    onClick={() => {
+                      void enable();
+                    }}
+                  >
+                    {localize('com_fs_enable_write')}
+                  </Button>
+                )}
+                <Button
+                  variant="quiet"
+                  onClick={() => {
+                    disconnect(entry);
+                    setSelected('');
+                  }}
+                >
+                  {localize('com_fs_disconnect')}
+                </Button>
+                <Button
+                  variant="quiet"
+                  onClick={() => {
+                    void client.invalidateQueries({
+                      queryKey: [QueryKeys.localFiles, owner, entry.root.id],
+                    });
+                  }}
+                >
+                  {localize('com_fs_refresh')}
+                </Button>
+              </div>
+              <Tree key={entry.root.id} entry={entry} onOpen={setSelected} />
+              {selected && (
+                <section className="min-w-0" aria-label={localize('com_fs_preview')}>
+                  <h3 className="font-medium break-all">
+                    <bdi>{boundApprovalLabel(selected, 4096).label}</bdi>
+                  </h3>
+                  {preview.isLoading && <Loading />}
+                  {preview.isError && (
+                    <p role="alert">{localize(errorKeys[filesystemError(preview.error)])}</p>
+                  )}
+                  {preview.data?.binary && (
+                    <>
+                      {[
+                        'image/jpeg',
+                        'image/png',
+                        'image/webp',
+                        'image/gif',
+                        'image/avif',
+                      ].includes(preview.data.binary.mime) && (
+                        <img
+                          src={`data:${preview.data.binary.mime};base64,${preview.data.binary.data}`}
+                          alt={localize('com_fs_preview')}
+                          className="max-h-96 max-w-full object-contain"
+                        />
+                      )}
+                      <p className="text-text-secondary text-sm">
+                        {localize('com_fs_document_preview')}
+                      </p>
+                    </>
+                  )}
+                  {preview.data?.content != null && (
+                    <pre
+                      className="border-border-light max-h-96 overflow-auto rounded-md border p-2 text-sm break-words whitespace-pre-wrap"
+                      dir="auto"
+                    >
+                      {preview.data.content}
+                    </pre>
+                  )}
+                </section>
+              )}
+            </>
+          )}
+        </>
+      )}
+      {failure && <p role="alert">{localize(errorKeys[failure])}</p>}
+    </section>
+  );
+}
diff --git a/client/src/components/Filesystem/Review.tsx b/client/src/components/Filesystem/Review.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..02fc7b648808352dcf04ac6d59e97b5eccb60cde
--- /dev/null
+++ b/client/src/components/Filesystem/Review.tsx
@@ -0,0 +1,193 @@
+import { useContext, useEffect, useState } from 'react';
+import { Button } from '@librechat/client';
+import { useQuery } from '@tanstack/react-query';
+import { boundApprovalLabel } from '@librechat/chat';
+import { useComposerPresentsApproval } from '@librechat/chat/react';
+import { QueryKeys, localFilesInputSchema, localFilesOperation } from 'librechat-data-provider';
+import type { Agents } from 'librechat-data-provider';
+import {
+  useApprovalContext,
+  useResumeSubmit,
+} from '~/components/Chat/Messages/Content/ApprovalContext';
+import { FilesystemError, filesystemError } from './engine';
+import { ChatContext } from '~/Providers/ChatContext';
+import useLocalize from '~/hooks/useLocalize';
+import { useConnections } from './connection';
+import { errorKeys } from './copy';
+import Loading from './Loading';
+
+export interface LocalReviewProps {
+  name?: string;
+  approval: NonNullable<Agents.ToolCall['approval']>;
+  toolCallId: string;
+  args: string | Record<string, unknown> | undefined;
+  surface?: 'thread' | 'composer';
+}
+export default function Review({
+  name = '',
+  approval,
+  toolCallId,
+  args,
+  surface = 'thread',
+}: LocalReviewProps) {
+  const localize = useLocalize();
+  const [failure, setFailure] = useState<ReturnType<typeof filesystemError>>();
+  const conversationId = useContext(ChatContext)?.conversation?.conversationId ?? '';
+  const entry = useConnections().get(conversationId);
+  const { actionId } = approval;
+  const composer = useComposerPresentsApproval(conversationId, actionId);
+  const {
+    registerToolCall,
+    unregisterToolCall,
+    setDecision,
+    getDecision,
+    getStatus,
+    isReady,
+    getLeadToolCallId,
+  } = useApprovalContext();
+  const { submitToolApproval } = useResumeSubmit();
+  const preview = useQuery({
+    queryKey: [
+      QueryKeys.localFiles,
+      entry?.owner,
+      entry?.root.id,
+      entry?.session?.id,
+      'review',
+      actionId,
+      toolCallId,
+      args,
+    ],
+    enabled: !!entry?.session,
+    queryFn: async () => {
+      let parsed: unknown;
+      try {
+        parsed = typeof args === 'string' ? JSON.parse(args) : args;
+      } catch {
+        throw new FilesystemError('INVALID_REQUEST');
+      }
+      if (parsed == null || typeof parsed !== 'object' || Array.isArray(parsed))
+        throw new FilesystemError('INVALID_REQUEST');
+      const input = localFilesInputSchema.safeParse({
+        ...parsed,
+        operation: localFilesOperation(name),
+      });
+      if (!input.success) throw new FilesystemError('INVALID_REQUEST');
+      if (!entry?.session) throw new FilesystemError('UNAVAILABLE');
+      try {
+        return await entry.engine.preview(input.data, entry.session.id);
+      } catch (error) {
+        throw new FilesystemError(filesystemError(error));
+      }
+    },
+    retry: false,
+    staleTime: Infinity,
+    refetchOnWindowFocus: false,
+  });
+  useEffect(() => {
+    registerToolCall(actionId, toolCallId);
+    return () => unregisterToolCall(actionId, toolCallId);
+  }, [actionId, toolCallId, registerToolCall, unregisterToolCall]);
+  const status = getStatus(actionId);
+  const locked = status === 'submitting' || status === 'submitted' || status === 'expired';
+  const decision = getDecision(actionId, toolCallId);
+  if (status === 'submitted' || (surface === 'thread' && composer)) return null;
+  const ready = preview.data;
+  return (
+    <div
+      data-testid="tool-approval"
+      data-tool-call-id={toolCallId}
+      className="border-border-medium my-2 flex min-w-0 flex-col gap-2 rounded-lg border p-3"
+    >
+      <p className="font-medium">{localize('com_fs_review_title')}</p>
+      {!entry?.session && <p role="alert">{localize('com_fs_original_tab')}</p>}
+      {entry?.session && preview.isLoading && <Loading />}
+      {entry?.session && preview.isError && (
+        <p role="alert">{localize(errorKeys[filesystemError(preview.error)])}</p>
+      )}
+      {ready && (
+        <>
+          <p className="break-all">
+            <bdi>{boundApprovalLabel(ready.input.path, 4096).label}</bdi>
+          </p>
+          {ready.input.operation === 'move' ? (
+            <>
+              <p className="break-all">
+                <bdi>{boundApprovalLabel(ready.input.destination, 4096).label}</bdi>
+              </p>
+              <p>{localize('com_fs_move_notice')}</p>
+            </>
+          ) : (
+            ready.input.operation !== 'mkdir' && (
+              <>
+                <h4 className="font-medium">{localize('com_fs_before')}</h4>
+                <pre
+                  dir="auto"
+                  className="max-h-60 overflow-auto text-sm break-words whitespace-pre-wrap"
+                >
+                  {ready.before}
+                </pre>
+                <h4 className="font-medium">{localize('com_fs_after')}</h4>
+                <pre
+                  dir="auto"
+                  className="max-h-60 overflow-auto text-sm break-words whitespace-pre-wrap"
+                >
+                  {ready.after}
+                </pre>
+              </>
+            )
+          )}
+        </>
+      )}
+      <div className="flex flex-wrap gap-2">
+        <Button
+          aria-pressed={decision?.decision === 'approve'}
+          variant={decision?.decision === 'approve' ? 'default' : 'outline'}
+          disabled={
+            locked ||
+            !ready ||
+            !entry?.engine.canWrite ||
+            !approval.allowed_decisions?.includes('approve')
+          }
+          onClick={() => {
+            if (!ready || !entry) return;
+            try {
+              setDecision(actionId, toolCallId, {
+                tool_call_id: toolCallId,
+                decision: 'approve',
+                scope: 'once',
+                localFiles: entry.engine.approve(ready, toolCallId),
+              });
+              setFailure(undefined);
+            } catch (error) {
+              setFailure(filesystemError(error));
+              setDecision(actionId, toolCallId, null);
+            }
+          }}
+        >
+          {localize('com_ui_approve')}
+        </Button>
+        <Button
+          aria-pressed={decision?.decision === 'reject'}
+          variant={decision?.decision === 'reject' ? 'default' : 'outline'}
+          disabled={locked}
+          onClick={() => {
+            if (ready) entry?.engine.revoke(ready.review.id);
+            setDecision(actionId, toolCallId, { tool_call_id: toolCallId, decision: 'reject' });
+          }}
+        >
+          {localize('com_ui_reject')}
+        </Button>
+        {surface === 'thread' && getLeadToolCallId(actionId) === toolCallId && (
+          <Button
+            disabled={locked || !isReady(actionId)}
+            onClick={() => submitToolApproval(actionId)}
+          >
+            {localize('com_ui_submit')}
+          </Button>
+        )}
+      </div>
+      <p className="text-text-secondary text-sm">{localize('com_fs_once')}</p>
+      {failure && <p role="alert">{localize(errorKeys[failure])}</p>}
+    </div>
+  );
+}
diff --git a/client/src/components/Filesystem/Tree.tsx b/client/src/components/Filesystem/Tree.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..91e7647bafa52dd9e36f03fe9d2c2774fb6fb694
--- /dev/null
+++ b/client/src/components/Filesystem/Tree.tsx
@@ -0,0 +1,97 @@
+import { useState } from 'react';
+import { Button } from '@librechat/client';
+import { QueryKeys } from 'librechat-data-provider';
+import { boundApprovalLabel } from '@librechat/chat';
+import { useInfiniteQuery } from '@tanstack/react-query';
+import { ChevronRight, ChevronDown, File, Folder } from 'lucide-react';
+import type { Connection } from './connection';
+import { FilesystemError, filesystemError } from './engine';
+import useLocalize from '~/hooks/useLocalize';
+import { errorKeys } from './copy';
+import Loading from './Loading';
+
+export default function Tree({
+  entry,
+  path = '',
+  onOpen,
+}: {
+  entry: Connection;
+  path?: string;
+  onOpen: (path: string) => void;
+}) {
+  const localize = useLocalize();
+  const [expanded, setExpanded] = useState<ReadonlySet<string>>(new Set());
+  const query = useInfiniteQuery({
+    queryKey: [QueryKeys.localFiles, entry.owner, entry.root.id, 'list', path],
+    queryFn: async ({ pageParam = 0 }) => {
+      const result = await entry.engine.inspect({
+        operation: 'list',
+        path,
+        cursor: Number(pageParam),
+      });
+      if (!result.ok) throw new FilesystemError(result.error.code);
+      return result.value;
+    },
+    getNextPageParam: (page) => page.nextCursor,
+    retry: false,
+    refetchOnWindowFocus: false,
+  });
+  if (query.isLoading) return <Loading />;
+  if (query.isError) return <p role="alert">{localize(errorKeys[filesystemError(query.error)])}</p>;
+  const entries = query.data.pages.flatMap((page) => page.entries ?? []);
+  return (
+    <div className="min-w-0">
+      {entries.length === 0 && (
+        <p className="text-text-secondary p-2 text-sm">{localize('com_fs_empty')}</p>
+      )}
+      <ul aria-label={localize('com_fs_files')} className="min-w-0 ps-2">
+        {entries.map((item) => {
+          const child = path ? `${path}/${item.name}` : item.name;
+          const open = expanded.has(child);
+          const directory = item.kind === 'directory';
+          return (
+            <li key={item.name} className="min-w-0">
+              <Button
+                variant="quiet"
+                size="sm"
+                className="w-full justify-start"
+                aria-expanded={directory ? open : undefined}
+                onClick={() => {
+                  if (!directory) {
+                    onOpen(child);
+                    return;
+                  }
+                  setExpanded((previous) => {
+                    const next = new Set(previous);
+                    if (open) next.delete(child);
+                    else next.add(child);
+                    return next;
+                  });
+                }}
+              >
+                {directory && open && <ChevronDown className="size-4 shrink-0" />}
+                {directory && !open && <ChevronRight className="size-4 shrink-0" />}
+                {!directory && <File className="size-4 shrink-0" />}
+                {directory && <Folder className="size-4 shrink-0" />}
+                <bdi className="truncate">{boundApprovalLabel(item.name, 255).label}</bdi>
+              </Button>
+              {directory && open && <Tree entry={entry} path={child} onOpen={onOpen} />}
+            </li>
+          );
+        })}
+      </ul>
+      {query.hasNextPage && (
+        <Button
+          variant="outline"
+          size="sm"
+          disabled={query.isFetchingNextPage}
+          onClick={() => {
+            void query.fetchNextPage();
+          }}
+        >
+          {localize('com_ui_load_more')}
+        </Button>
+      )}
+    </div>
+  );
+}
